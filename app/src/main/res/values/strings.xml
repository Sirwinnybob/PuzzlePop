    <!-- About, privacy and open-source licenses (from grown-up settings) -->
    <string name="settings_about">About, privacy and licenses</string>
    <string name="about_title">About PuzzlePop</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">PuzzlePop has no ads, no accounts and no analytics, and it can\'t use the internet. Your photos, puzzles, settings and PIN stay on this tablet in the app\'s own storage. They aren\'t backed up to the cloud, and uninstalling the app deletes them. Fingerprint checks are done by Android, so the app never sees your fingerprint.</string>
    <string name="about_privacy_link">Read the full privacy policy</string>
