<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8-9 have no system dark mode, so the base is the light platform theme;
         values-v29 swaps in DayNight and values-v31 adds the splash-screen colour. -->
    <style name="Theme.PuzzlePop.Base" parent="android:Theme.DeviceDefault.Light" />
    <style name="Theme.PuzzlePop.Platform" parent="Theme.PuzzlePop.Base" />

    <!-- The window background matches the Compose background so there is no white flash in dark mode. -->
    <style name="Theme.PuzzlePop" parent="Theme.PuzzlePop.Platform">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
